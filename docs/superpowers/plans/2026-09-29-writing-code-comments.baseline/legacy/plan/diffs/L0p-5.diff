+import os
+import sqlite3
+import unittest
+
+from readings import runner
+from readings.parse import Reading
+from readings.runner import Summary
+from readings.store import Marker, Store
+from tests.helpers import HEADER, row, temp_dir, write
+
+A = "ST014_202601150600.csv"
+B = "ST014_202601151200.csv"
+
+
+def dump(path):
+    """Both tables, read through a fresh connection: what the commits left behind."""
+    db = sqlite3.connect(path)
+    try:
+        return (db.execute("SELECT key, body FROM readings ORDER BY key").fetchall(),
+                db.execute("SELECT name, state, failures, detail FROM markers ORDER BY name").fetchall())
+    finally:
+        db.close()
+
+
+class FailingStore(Store):
+    """A real Store whose n-th add fails the way a full disk does."""
+
+    def __init__(self, path, fail_on_add):
+        super().__init__(path)
+        self.adds = 0
+        self.fail_on_add = fail_on_add
+
+    def add(self, key, reading):
+        self.adds += 1
+        if self.adds == self.fail_on_add:
+            raise sqlite3.OperationalError("database or disk is full")
+        return super().add(key, reading)
+
+
+class RunTest(unittest.TestCase):
+    def setUp(self):
+        base = temp_dir(self)
+        self.inbox = os.path.join(base, runner.INBOX_DIR)
+        os.mkdir(self.inbox)
+        self.db = os.path.join(base, "readings.db")
+
+    def run_once(self, **kwargs):
+        store = Store(self.db)
+        try:
+            return runner.run(self.inbox, store, **kwargs)
+        finally:
+            store.close()
+
+    def marker(self, name):
+        store = Store(self.db)
+        try:
+            return store.marker(name)
+        finally:
+            store.close()
+
+    def reading(self, key):
+        store = Store(self.db)
+        try:
+            return store.get(key)
+        finally:
+            store.close()
+
+    def test_key_is_station_time_and_quantity(self):
+        reading = Reading("ST014", 7, "2026-01-15T01:00", "temperature", 3.1)
+        self.assertEqual(runner.key(reading), "ST014|2026-01-15T01:00|temperature")
+
+    def test_overlapping_exports_store_each_reading_once(self):
+        write(self.inbox, A, HEADER + row(0) + row(1) + row(2))
+        # the next export: 01:00 is row 1 here and row 2 in A
+        write(self.inbox, B, HEADER + row(1) + row(2) + row(3))
+
+        self.assertEqual(self.run_once(), Summary(files=2, imported=2, stored=12, duplicates=6))
+
+        readings, _ = dump(self.db)
+        self.assertEqual(len(readings), 12)
+        self.assertEqual(self.reading("ST014|2026-01-15T01:00|temperature"),
+                         {"station": "ST014", "row": 2, "time": "2026-01-15T01:00",
+                          "quantity": "temperature", "value": 3.1})
+        self.assertEqual(self.marker(A), Marker("done", 0, "9 stored, 0 duplicates, 0 rejected"))
+        self.assertEqual(self.marker(B), Marker("done", 0, "3 stored, 6 duplicates, 0 rejected"))
+
+    def test_second_run_skips_every_file_and_changes_nothing(self):
+        write(self.inbox, A, HEADER + row(0) + row(1))
+        write(self.inbox, B, HEADER + row(1) + row(2))
+        self.run_once()
+        before = dump(self.db)
+
+        self.assertEqual(self.run_once(), Summary(files=2, skipped=2))
+        self.assertEqual(dump(self.db), before)
+
+    def test_bad_row_is_rejected_and_the_rest_of_the_file_imports(self):
+        write(self.inbox, A, HEADER + row(0) + "--:--,3.1,1012.4,4.2\n" + row(2))
+
+        self.assertEqual(self.run_once(), Summary(files=1, imported=1, stored=6, rejected=1))
+        self.assertEqual(len(dump(self.db)[0]), 6)
+        self.assertEqual(self.marker(A), Marker("done", 0, "6 stored, 0 duplicates, 1 rejected"))

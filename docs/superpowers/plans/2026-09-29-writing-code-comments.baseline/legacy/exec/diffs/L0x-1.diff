@@ -0,0 +1,47 @@
+"""The command line: one unattended run over the inbox, answered by exit status."""
+import argparse
+import os
+import sys
+
+from . import runner
+from .store import Store
+
+DB_PATH = "readings.db"
+
+# The summary line's fields, in the order runner.Summary declares them.
+COUNTS = ("files", "imported", "skipped", "failed", "poisoned", "stored", "duplicates", "rejected")
+
+
+def summary_line(summary):
+    return " ".join(f"{name}={getattr(summary, name)}" for name in COUNTS)
+
+
+def exit_status(summary):
+    """0 nothing needs a person; 1 a failure the next run retries; 3 a person is needed."""
+    if summary.poisoned:
+        return 3
+    if summary.failed:
+        return 1
+    return 0
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="python3 -m readings",
+        description="Import the station exports in the inbox into the reading store.")
+    parser.add_argument("--inbox", default=runner.INBOX_DIR,
+                        help="directory the exports are copied into (default: %(default)s)")
+    parser.add_argument("--db", default=DB_PATH,
+                        help="the store's SQLite file (default: %(default)s)")
+    args = parser.parse_args(argv)
+    if not os.path.isdir(args.inbox):
+        parser.error(f"inbox is not a directory: {args.inbox}")
+    store = Store(args.db)
+    try:
+        summary = runner.run(args.inbox, store)
+    finally:
+        store.close()
+    for name, marker in summary.problems:
+        print(f"{name}: {marker.state} ({marker.failures}): {marker.detail}", file=sys.stderr)
+    print(summary_line(summary))
+    return exit_status(summary)

diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..f670842
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,117 @@
+import contextlib
+import io
+import os
+import subprocess
+import sys
+import unittest
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+A = "ST014_202601150600.csv"
+B = "ST014_202601151200.csv"
+C = "ST014_202601151800.csv"
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def rows(*times):
+    """An export: one row per time, the same three values in each."""
+    return HEADER + "".join(f"{time},3.1,1012.4,4.2\n" for time in times)
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        directory = temp_dir(self)
+        self.inbox = os.path.join(directory, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(directory, "readings.db")
+
+    def main(self, *argv):
+        """(exit status, stdout, stderr) of one cli.main over the test inbox and store."""
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = cli.main(["--inbox", self.inbox, "--db", self.db, *argv])
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        try:
+            return store.count()
+        finally:
+            store.close()
+
+    def utf16(self, name):
+        """An export from the station whose firmware switched it to UTF-16 (§3)."""
+        with open(os.path.join(self.inbox, name), "w", encoding="utf-16") as f:
+            f.write(rows("2026-01-15T06:00"))
+
+    def test_clean_run_prints_one_line_and_exits_0(self):
+        write(self.inbox, A, rows("2026-01-15T00:00", "2026-01-15T01:00", "2026-01-15T02:00"))
+        write(self.inbox, B, rows("2026-01-15T01:00", "2026-01-15T02:00", "2026-01-15T03:00"))
+        self.assertEqual(self.main(), (0, "files=2 imported=2 skipped=0 failed=0 poisoned=0 "
+                                          "stored=12 duplicates=6 rejected=0\n", ""))
+        self.assertEqual(self.stored(), 12)
+
+    def test_second_run_over_the_same_inbox(self):
+        write(self.inbox, A, rows("2026-01-15T00:00", "2026-01-15T01:00"))
+        write(self.inbox, B, rows("2026-01-15T01:00", "2026-01-15T02:00"))
+        self.main()
+        self.assertEqual(self.main(), (0, "files=2 imported=0 skipped=2 failed=0 poisoned=0 "
+                                          "stored=0 duplicates=0 rejected=0\n", ""))
+        self.assertEqual(self.stored(), 9)
+
+    def test_summary_line_matches_the_spec_example(self):
+        write(self.inbox, A, rows(*(f"2026-01-15T{h:02}:00" for h in range(6))))
+        self.main()
+        write(self.inbox, B, rows(*(f"2026-01-15T{h:02}:00" for h in range(4, 12)))
+              + "--:--,3.0,1012.1,4.0\n")
+        write(self.inbox, C, rows(*(f"2026-01-15T{h:02}:00" for h in range(12, 16))))
+        self.utf16("ST014_202601160000.csv")
+        status, out, _ = self.main()
+        self.assertEqual((status, out), (1, "files=4 imported=2 skipped=1 failed=1 poisoned=0 "
+                                            "stored=30 duplicates=6 rejected=1\n"))
+        self.assertEqual(self.stored(), 48)
+
+    def test_unreadable_file_exits_1_1_3_3(self):
+        write(self.inbox, A, rows("2026-01-15T00:00"))
+        self.utf16(B)
+        runs = [self.main() for _ in range(4)]
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertEqual([err.split(": not text")[0] for _, _, err in runs],
+                         [f"{B}: failed (1)", f"{B}: failed (2)", f"{B}: poisoned (3)", ""])
+        self.assertEqual(runs[3][1], "files=2 imported=0 skipped=1 failed=0 poisoned=1 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(self.stored(), 3)
+
+    def test_poisoned_file_outranks_a_fresh_failure(self):
+        self.utf16(A)
+        for _ in range(3):
+            self.main()
+        self.utf16(B)
+        status, out, err = self.main()
+        self.assertEqual(status, 3)
+        self.assertIn("failed=1 poisoned=1", out)
+        self.assertEqual([line.split(": not text")[0] for line in err.splitlines()],
+                         [f"{B}: failed (1)"])
+        self.assertEqual(self.stored(), 0)
+
+    def test_empty_inbox_exits_0(self):
+        self.assertEqual(self.main(), (0, "files=0 imported=0 skipped=0 failed=0 poisoned=0 "
+                                          "stored=0 duplicates=0 rejected=0\n", ""))
+
+    def test_missing_inbox_is_a_usage_error(self):
+        self.inbox = os.path.join(self.inbox, "missing")
+        with self.assertRaises(SystemExit) as raised:
+            self.main()
+        self.assertEqual(raised.exception.code, 2)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_python_m_readings(self):
+        write(self.inbox, A, rows("2026-01-15T00:00"))
+        done = subprocess.run([sys.executable, "-m", "readings", "--inbox", self.inbox,
+                               "--db", self.db], cwd=REPO, capture_output=True, text=True)
+        self.assertEqual((done.returncode, done.stdout, done.stderr),
+                         (0, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                             "stored=3 duplicates=0 rejected=0\n", ""))
+        self.assertEqual(self.stored(), 3)

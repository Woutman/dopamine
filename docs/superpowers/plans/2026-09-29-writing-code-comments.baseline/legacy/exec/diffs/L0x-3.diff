@@ -0,0 +1,120 @@
+import contextlib
+import io
+import os
+import subprocess
+import sys
+import unittest
+
+from readings import cli, runner
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+ROW_00 = "2026-01-15T00:00,3.1,1012.4,4.2\n"
+ROW_01 = "2026-01-15T01:00,3.0,1012.1,3.9\n"
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.base = temp_dir(self)
+        self.inbox = os.path.join(self.base, runner.INBOX_DIR)
+        os.mkdir(self.inbox)
+        self.db = os.path.join(self.base, "readings.db")
+
+    def main(self, *extra):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = cli.main(["--inbox", self.inbox, "--db", self.db, *extra])
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        return store.count()
+
+    def test_a_clean_run_exits_0_with_the_summary_line(self):
+        write(self.inbox, "ST014_202601150600.csv", HEADER + ROW_00 + "--:--,3.0,1012.1,3.9\n")
+        write(self.inbox, "ST014_202601151200.csv", HEADER + ROW_00 + ROW_01)
+        status, out, err = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=2 imported=2 skipped=0 failed=0 poisoned=0 "
+                              "stored=6 duplicates=3 rejected=1\n")
+        self.assertEqual(err, "")
+        self.assertEqual(self.stored(), 6)
+
+    def test_an_empty_inbox_exits_0(self):
+        write(self.inbox, "README.txt", "exports arrive here\n")
+        status, out, err = self.main()
+        self.assertEqual((status, err), (0, ""))
+        self.assertEqual(out, "files=0 imported=0 skipped=0 failed=0 poisoned=0 "
+                              "stored=0 duplicates=0 rejected=0\n")
+
+    def test_an_unreadable_file_exits_1_1_3_3(self):
+        write(self.inbox, "ST014_202601150600.csv", "garbage\n")
+        write(self.inbox, "ST014_202601151200.csv", HEADER + ROW_01)
+        runs = [self.main() for _ in range(4)]
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertEqual([err for _, _, err in runs], [
+            "ST014_202601150600.csv: failed (1): header has no delimiter\n",
+            "ST014_202601150600.csv: failed (2): header has no delimiter\n",
+            "ST014_202601150600.csv: poisoned (3): header has no delimiter\n",
+            "",
+        ])
+        self.assertEqual(runs[3][1], "files=2 imported=0 skipped=1 failed=0 poisoned=1 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(self.stored(), 3)
+
+    def test_poisoned_takes_precedence_over_failed(self):
+        write(self.inbox, "ST014_202601150600.csv", "garbage\n")
+        store = Store(self.db)
+        store.set_marker("ST014_202601150600.csv", "poisoned", runner.POISON_AFTER, "header has no delimiter")
+        store.commit()
+        store.close()
+        write(self.inbox, "ST015_202601150600.csv", "time,temp_c,humidity\n")
+        status, out, err = self.main()
+        self.assertEqual(status, 3)
+        self.assertEqual(out, "files=2 imported=0 skipped=0 failed=1 poisoned=1 "
+                              "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(err, "ST015_202601150600.csv: failed (1): unknown column: humidity\n")
+
+    def test_a_missing_inbox_is_a_usage_error(self):
+        missing = os.path.join(self.base, "no-such-inbox")
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as caught:
+            cli.main(["--inbox", missing, "--db", self.db])
+        self.assertEqual(caught.exception.code, 2)
+        self.assertIn("no-such-inbox", err.getvalue())
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_an_unknown_option_is_a_usage_error(self):
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as caught:
+            cli.main(["--inbox", self.inbox, "--workers", "8"])
+        self.assertEqual(caught.exception.code, 2)
+
+
+class ModuleTest(unittest.TestCase):
+    """python3 -m readings, through a real interpreter: the exit status the timer sees."""
+
+    def setUp(self):
+        self.base = temp_dir(self)
+        os.mkdir(os.path.join(self.base, "inbox"))
+        write(os.path.join(self.base, "inbox"), "ST014_202601150600.csv", HEADER + ROW_00)
+
+    def python_m(self, *args):
+        env = dict(os.environ, PYTHONPATH=REPO)
+        return subprocess.run([sys.executable, "-m", "readings", *args], cwd=self.base, env=env,
+                              capture_output=True, text=True)
+
+    def test_defaults_are_inbox_and_readings_db_in_the_working_directory(self):
+        done = self.python_m()
+        self.assertEqual(done.returncode, 0, done.stderr)
+        self.assertEqual(done.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                      "stored=3 duplicates=0 rejected=0\n")
+        self.assertTrue(os.path.exists(os.path.join(self.base, "readings.db")))
+
+    def test_a_store_that_cannot_be_opened_stops_the_run_with_1(self):
+        os.mkdir(os.path.join(self.base, "a-directory"))
+        done = self.python_m("--db", "a-directory")
+        self.assertEqual(done.returncode, 1)
+        self.assertEqual(done.stdout, "")

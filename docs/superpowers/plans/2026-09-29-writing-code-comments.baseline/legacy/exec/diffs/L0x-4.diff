@@ -0,0 +1,115 @@
+import contextlib
+import io
+import os
+import subprocess
+import sys
+import unittest
+
+from readings import cli, runner
+from readings.store import Marker, Store
+from tests.helpers import HEADER, ROW, temp_dir, write
+
+A = "ST014_202601150600.csv"
+B = "ST014_202601151200.csv"
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class CliTest(unittest.TestCase):
+    def setUp(self):
+        base = temp_dir(self)
+        self.inbox = os.path.join(base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(base, "readings.db")
+
+    def main(self, *extra):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = cli.main(["--inbox", self.inbox, "--db", self.db, *extra])
+        return code, out.getvalue(), err.getvalue()
+
+    def store(self):
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        return store
+
+    def test_a_clean_run_prints_the_summary_and_exits_0(self):
+        write(self.inbox, A, HEADER + ROW[0] + ROW[1])
+        write(self.inbox, B, HEADER + ROW[1] + "--:--,3.1,1012.4,4.2\n")
+        code, out, err = self.main()
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "files=2 imported=2 skipped=0 failed=0 poisoned=0 "
+                              "stored=6 duplicates=3 rejected=1\n")
+        self.assertEqual(err, "")
+        self.assertEqual(self.store().count(), 6)
+
+    def test_a_second_run_skips_and_exits_0(self):
+        write(self.inbox, A, HEADER + ROW[0])
+        self.main()
+        code, out, _ = self.main()
+        self.assertEqual(code, 0)
+        self.assertEqual(out, "files=1 imported=0 skipped=1 failed=0 poisoned=0 "
+                              "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(self.store().count(), 3)
+
+    def test_an_unreadable_file_exits_1_1_3_3(self):
+        write(self.inbox, A, "garbage\n")
+        write(self.inbox, B, HEADER + ROW[0])
+        results = [self.main() for _ in range(4)]
+        self.assertEqual([code for code, _, _ in results], [1, 1, 3, 3])
+        self.assertEqual(results[0][1], "files=2 imported=1 skipped=0 failed=1 poisoned=0 "
+                                        "stored=3 duplicates=0 rejected=0\n")
+        self.assertEqual(results[0][2], f"{A}: failed (1): header has no delimiter\n")
+        self.assertEqual(results[2][2], f"{A}: poisoned (3): header has no delimiter\n")
+        self.assertEqual(results[3][2], "")
+        store = self.store()
+        self.assertEqual(store.marker(A), Marker("poisoned", 3, "header has no delimiter"))
+        self.assertEqual(store.count(), 3)
+
+    def test_poisoned_takes_precedence_over_failed(self):
+        write(self.inbox, A, HEADER + ROW[0])
+        write(self.inbox, B, "garbage\n")
+        store = self.store()
+        store.set_marker(A, "poisoned", 3, "not text")
+        store.commit()
+        code, out, _ = self.main()
+        self.assertEqual(code, 3)
+        self.assertIn(" failed=1 poisoned=1 ", out)
+        self.assertEqual(self.store().count(), 0)
+
+    def test_recovered_file_exits_0(self):
+        write(self.inbox, A, "")
+        self.assertEqual(self.main()[0], 1)
+        write(self.inbox, A, HEADER + ROW[0])
+        self.assertEqual(self.main()[0], 0)
+        self.assertEqual(self.store().marker(A).state, "done")
+
+    def test_a_missing_inbox_is_a_usage_error(self):
+        missing = os.path.join(self.inbox, "nope")
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as caught:
+            cli.main(["--inbox", missing, "--db", self.db])
+        self.assertEqual(caught.exception.code, 2)
+        self.assertIn("nope", err.getvalue())
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_defaults(self):
+        self.assertEqual(runner.INBOX_DIR, "inbox")
+        self.assertEqual(cli.DEFAULT_DB, "readings.db")
+        cwd = os.getcwd()
+        self.addCleanup(os.chdir, cwd)
+        os.chdir(os.path.dirname(self.inbox))
+        write(self.inbox, A, HEADER + ROW[0])
+        with contextlib.redirect_stdout(io.StringIO()):
+            self.assertEqual(cli.main([]), 0)
+        self.assertEqual(self.store().count(), 3)
+
+    def test_the_module_exits_with_mains_status(self):
+        write(self.inbox, A, HEADER + ROW[0])
+        store = self.store()
+        store.set_marker(A, "poisoned", 3, "not text")
+        store.commit()
+        done = subprocess.run([sys.executable, "-m", "readings", "--inbox", self.inbox,
+                               "--db", self.db], cwd=ROOT, capture_output=True, text=True)
+        self.assertEqual(done.returncode, 3)
+        self.assertEqual(done.stdout, "files=1 imported=0 skipped=0 failed=0 poisoned=1 "
+                                      "stored=0 duplicates=0 rejected=0\n")

+In `readings/parse.py`, `Reading` becomes:
+
+```python
+@dataclass
+class Reading:
+    station: str
+    row: int
+    time: str
+    quantity: str
+    value: float
+```
+
+and `parse_file` becomes the following. It adds the header check, drops `KeyError` from the row
+`except`, since the header check now guarantees every column is known, and deletes the comment
+about stable row numbers, which was there because the row was part of the key.
+
+```python
+def parse_file(path):
+    """(readings, rejected row numbers) for one export.
+
+    Raises FileError when the file's name is not a station export's, it is not
+    UTF-8, its header has no delimiter, its first column is not time, or it has a
+    column units.COLUMNS does not know.
+    """
+    station = station_of(path)
+    try:
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+    except UnicodeDecodeError as e:
+        raise FileError(f"not text: {e}") from None
+    try:
+        found = dialect.sniff(text)
+    except ValueError as e:
+        raise FileError(str(e)) from None
+    header, *body = dialect.rows(text, found)
+    if not header or header[0] != "time":
+        raise FileError("first column is not time")
+    unknown = [column for column in header[1:] if column not in units.COLUMNS]
+    if unknown:
+        raise FileError(f"unknown column: {', '.join(unknown)}")
+
+    readings, rejected = [], []
+    for row, fields in enumerate(body, 1):
+        if len(fields) != len(header):
+            rejected.append(row)
+            continue
+        try:
+            time = datetime.fromisoformat(fields[0]).isoformat(timespec="minutes")
+            values = [units.convert(c, f, found.decimal) for c, f in zip(header[1:], fields[1:])]
+        except ValueError:
+            rejected.append(row)
+            continue
+        for converted in values:
+            if converted is not None:
+                readings.append(Reading(station, row, time, *converted))
+    return readings, rejected
+```

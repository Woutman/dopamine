+
+```python
+def run(inbox, store):
+    """Import every *.csv file in inbox into store, in name order; return a Summary.
+
+    A file's readings and its marker are committed together. A FileError fails
+    that file and the run goes on; any other exception rolls back the file in
+    hand and propagates.
+    """
+    summary = Summary()
+    for name in exports(inbox):
+        summary.files += 1
+        marker = store.marker(name)
+        state = marker.state if marker else None
+        if state == "done":
+            summary.skipped += 1
+        elif state == "poisoned":
+            summary.poisoned += 1
+        else:
+            try:
+                _import(inbox, name, marker, store, summary)
+            except BaseException:
+                store.rollback()
+                raise
+    return summary
+
+
+def _import(inbox, name, marker, store, summary):
+    try:
+        readings, rejected = parse_file(os.path.join(inbox, name))
+    except FileError as e:
+        _fail(name, marker, str(e), store, summary)
+        return
+    stored = duplicates = 0
+    for reading in readings:
+        if store.add(key(reading), dataclasses.asdict(reading)):
+            stored += 1
+        else:
+            duplicates += 1
+    store.set_marker(name, "done", 0,
+                     f"{stored} stored, {duplicates} duplicates, {len(rejected)} rejected")
+    store.commit()
+    summary.imported += 1
+    summary.stored += stored
+    summary.duplicates += duplicates
+    summary.rejected += len(rejected)
+
+
+def _fail(name, marker, detail, store, summary):
+    store.rollback()
+    failures = (marker.failures if marker else 0) + 1
+    state = "poisoned" if failures >= POISON_AFTER else "failed"
+    store.set_marker(name, state, failures, detail)
+    store.commit()
+    if state == "poisoned":
+        summary.poisoned += 1
+    else:
+        summary.failed += 1
+    print(f"{name}: {state} ({failures}): {detail}", file=sys.stderr)
+```
+
+A file that becomes poisoned this run counts as `poisoned`, not `failed`, which keeps
+`files == imported + skipped + failed + poisoned`. A file that was already poisoned is counted but
+not opened, and gets no stderr line. The stderr line is printed only after the marker commits, so
+it never reports a failure the store does not hold.

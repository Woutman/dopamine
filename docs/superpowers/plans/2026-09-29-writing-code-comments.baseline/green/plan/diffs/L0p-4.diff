+`parse_file` in `readings/parse.py` becomes:
+
+```python
+def parse_file(path):
+    """(readings, rejected row numbers) for one export.
+
+    Raises FileError when the file has no station name, cannot be read, is not
+    UTF-8, has no delimiter in its header, has no time column, or has a column
+    units.COLUMNS does not know.
+    """
+    station = station_of(path)
+    try:
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+    except UnicodeDecodeError as e:
+        raise FileError(f"not text: {e}") from None
+    except OSError as e:
+        raise FileError(f"cannot be read: {e}") from None
+    try:
+        found = dialect.sniff(text)
+    except ValueError as e:
+        raise FileError(str(e)) from None
+    header, *body = dialect.rows(text, found)
+    if not header or header[0] != "time":
+        raise FileError("first column is not time")
+    unknown = [column for column in header[1:] if column not in units.COLUMNS]
+    if unknown:
+        raise FileError(f"unknown column: {', '.join(unknown)}")
+
+    readings, rejected = [], []
+    for row, fields in enumerate(body, 1):
+        if len(fields) != len(header):
+            rejected.append(row)
+            continue
+        try:
+            time = datetime.fromisoformat(fields[0]).isoformat(timespec="minutes")
+            values = [units.convert(c, f, found.decimal) for c, f in zip(header[1:], fields[1:])]
+        except ValueError:
+            rejected.append(row)
+            continue
+        for converted in values:
+            if converted is not None:
+                readings.append(Reading(station, row, time, *converted))
+    return readings, rejected
+```
+
+Two notes for the implementer. `UnicodeDecodeError` must be caught before `OSError`: they are
+unrelated classes, but keeping the specific one first keeps the messages apart. The row loop now
+catches `ValueError` alone, because the header check means `units.convert` can no longer raise
+`KeyError`; the old comment claiming row numbers are stable is dropped, because spec §3 found they
+are not across files and nothing keys on them any more.
+

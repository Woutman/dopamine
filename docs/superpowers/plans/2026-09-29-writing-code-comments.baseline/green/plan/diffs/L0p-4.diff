+and `run` and `_import` become:
+
+```python
+def run(inbox, store, errors=None):
+    """Import every export in inbox into store, one file per transaction.
+
+    A file that raises FileError is marked failed, or poisoned once it has failed
+    POISON_AFTER runs, and the run goes on. Any other exception is not the file's
+    fault: the file's work is rolled back and the exception propagates.
+    """
+    errors = sys.stderr if errors is None else errors
+    summary = Summary()
+    for name in exports(inbox):
+        summary.files += 1
+        marker = store.marker(name)
+        if marker is not None and marker.state == "done":
+            summary.skipped += 1
+            continue
+        if marker is not None and marker.state == "poisoned":
+            summary.poisoned += 1
+            continue
+        try:
+            _import(inbox, name, marker, store, summary, errors)
+        except Exception:
+            store.rollback()
+            raise
+    return summary
+
+
+def _import(inbox, name, marker, store, summary, errors):
+    try:
+        readings, rejected = parse_file(os.path.join(inbox, name))
+    except FileError as e:
+        store.rollback()
+        failures = (0 if marker is None else marker.failures) + 1
+        state = "poisoned" if failures >= POISON_AFTER else "failed"
+        store.set_marker(name, state, failures, str(e))
+        store.commit()
+        if state == "poisoned":
+            summary.poisoned += 1
+        else:
+            summary.failed += 1
+        print(f"{name}: {state} ({failures}): {e}", file=errors)
+        return
+    stored = duplicates = 0
+    for reading in readings:
+        if store.add(key(reading), asdict(reading)):
+            stored += 1
+        else:
+            duplicates += 1
+    store.set_marker(name, "done", 0,
+                     f"{stored} stored, {duplicates} duplicates, {len(rejected)} rejected")
+    store.commit()
+    summary.imported += 1
+    summary.stored += stored
+    summary.duplicates += duplicates
+    summary.rejected += len(rejected)
+```
+
+The summary's counts for a file are added only after its commit, so a propagated exception never
+leaves a count for work that was rolled back.

new file mode 100644
index 0000000..8245d35
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,109 @@
+import io
+import os
+import subprocess
+import sys
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import A, A_TEXT, B, B_TEXT, HEADER, UTF16, temp_dir, write, write_bytes
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+UNKNOWN_COLUMN = "time,temp_c,humidity\n2026-01-15T01:00,3.0,80\n"
+
+
+class CliTest(unittest.TestCase):
+    def setUp(self):
+        base = temp_dir(self)
+        self.inbox = os.path.join(base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(base, "readings.db")
+
+    def invoke(self, argv):
+        """(exit status, stdout, stderr) of cli.main(argv)."""
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            try:
+                status = cli.main(argv)
+            except SystemExit as e:
+                status = e.code
+        return status, out.getvalue(), err.getvalue()
+
+    def main(self):
+        return self.invoke(["--inbox", self.inbox, "--db", self.db])
+
+    def committed(self):
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        return store
+
+    def test_clean_run_exits_0(self):
+        write(self.inbox, A, A_TEXT)
+        self.assertEqual(self.main(), (0, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                          "stored=6 duplicates=0 rejected=0\n", ""))
+        self.assertEqual(self.committed().count(), 6)
+
+    def test_summary_line_and_stderr_are_exact(self):
+        earlier, broken = "ST013_202601150600.csv", "ST015_202601151200.csv"
+        write(self.inbox, earlier, HEADER + "2026-01-15T00:00,1.0,1010.0,2.0\n")
+        self.main()
+        write(self.inbox, A, A_TEXT)
+        write(self.inbox, B, B_TEXT + "--:--,2.8,1011.7,3.7\n")
+        write(self.inbox, broken, UNKNOWN_COLUMN)
+        status, out, err = self.main()
+        self.assertEqual(status, 1)
+        self.assertEqual(out, "files=4 imported=2 skipped=1 failed=1 poisoned=0 "
+                              "stored=9 duplicates=3 rejected=1\n")
+        self.assertEqual(err, f"{broken}: failed (1): unknown columns: humidity\n")
+        self.assertEqual(self.committed().count(), 12)
+
+    def test_unreadable_file_exits_1_1_3_3(self):
+        write_bytes(self.inbox, A, UTF16)
+        runs = [self.main() for _ in range(4)]
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertTrue(runs[0][2].startswith(f"{A}: failed (1): not text: "))
+        self.assertTrue(runs[2][2].startswith(f"{A}: poisoned (3): not text: "))
+        self.assertEqual(runs[3][2], "")
+        self.assertEqual(runs[3][1], "files=1 imported=0 skipped=0 failed=0 poisoned=1 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(self.committed().count(), 0)
+
+    def test_poisoned_file_outranks_a_fresh_failure(self):
+        write(self.inbox, A, A_TEXT)
+        store = Store(self.db)
+        store.set_marker(A, "poisoned", 3, "not text")
+        store.commit()
+        store.close()
+        write(self.inbox, B, UNKNOWN_COLUMN)
+        status, out, err = self.main()
+        self.assertEqual(status, 3)
+        self.assertEqual(out, "files=2 imported=0 skipped=0 failed=1 poisoned=1 "
+                              "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(err, f"{B}: failed (1): unknown columns: humidity\n")
+        self.assertEqual(self.committed().count(), 0)
+
+    def test_missing_inbox_is_a_usage_error(self):
+        status, out, _ = self.invoke(["--inbox", os.path.join(self.inbox, "nope"), "--db", self.db])
+        self.assertEqual((status, out), (2, ""))
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_inbox_that_is_a_file_is_a_usage_error(self):
+        path = write(self.inbox, A, A_TEXT)
+        status, out, _ = self.invoke(["--inbox", path, "--db", self.db])
+        self.assertEqual((status, out), (2, ""))
+
+    def test_unknown_option_is_a_usage_error(self):
+        status, out, _ = self.invoke(["--inbx", self.inbox])
+        self.assertEqual((status, out), (2, ""))
+
+    def test_python_m_readings_uses_the_defaults(self):
+        cwd = temp_dir(self)
+        os.mkdir(os.path.join(cwd, "inbox"))
+        write(os.path.join(cwd, "inbox"), A, A_TEXT)
+        result = subprocess.run([sys.executable, "-m", "readings"], cwd=cwd, capture_output=True,
+                                text=True, env={**os.environ, "PYTHONPATH": ROOT})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                        "stored=6 duplicates=0 rejected=0\n")
+        self.assertTrue(os.path.exists(os.path.join(cwd, "readings.db")))

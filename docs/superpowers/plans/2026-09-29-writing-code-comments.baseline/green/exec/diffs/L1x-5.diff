@@ -0,0 +1,94 @@
+import io
+import os
+import subprocess
+import sys
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import HEADER, row, temp_dir, write
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        base = temp_dir(self)
+        self.inbox = os.path.join(base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(base, "readings.db")
+
+    def main(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = cli.main(list(argv) or ["--inbox", self.inbox, "--db", self.db])
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        return store.count()
+
+    def test_clean_run_exits_0(self):
+        write(self.inbox, "ST014_202601150600.csv", HEADER + row(0, 3.1))
+        self.assertEqual(self.main(), (
+            0, "files=1 imported=1 skipped=0 failed=0 poisoned=0 stored=3 duplicates=0 rejected=0\n",
+            ""))
+        self.assertEqual(self.stored(), 3)
+
+    def test_a_failed_file_exits_1_and_is_named_on_stderr(self):
+        write(self.inbox, "ST014_202601150600.csv", HEADER + row(0, 3.1) + row(1, 3.0))
+        self.main()
+        write(self.inbox, "ST014_202601151200.csv", HEADER + row(1, 3.0) + row(2, 2.9))
+        write(self.inbox, "ST020_202601150600.csv", HEADER + "--:--,3.1,1012.4,4.2\n" + row(0, 3.1))
+        write(self.inbox, "ST031_202601150600.csv", "garbage\n")
+        self.assertEqual(self.main(), (
+            1, "files=4 imported=2 skipped=1 failed=1 poisoned=0 stored=6 duplicates=3 rejected=1\n",
+            "ST031_202601150600.csv: failed (1): header has no delimiter\n"))
+        self.assertEqual(self.stored(), 12)
+
+    def test_unreadable_file_exits_1_1_3_3(self):
+        write(self.inbox, "ST031_202601150600.csv", "garbage\n")
+        statuses = [self.main()[0] for _ in range(4)]
+        self.assertEqual(statuses, [1, 1, 3, 3])
+        self.assertEqual(self.stored(), 0)
+
+    def test_poisoned_file_outranks_a_failed_one(self):
+        write(self.inbox, "ST031_202601150600.csv", "garbage\n")
+        for _ in range(3):
+            self.main()
+        write(self.inbox, "ST032_202601150600.csv", "garbage\n")
+        self.assertEqual(self.main(), (
+            3, "files=2 imported=0 skipped=0 failed=1 poisoned=1 stored=0 duplicates=0 rejected=0\n",
+            "ST032_202601150600.csv: failed (1): header has no delimiter\n"))
+
+    def test_empty_inbox_exits_0(self):
+        self.assertEqual(self.main(), (
+            0, "files=0 imported=0 skipped=0 failed=0 poisoned=0 stored=0 duplicates=0 rejected=0\n",
+            ""))
+
+    def test_missing_inbox_is_a_usage_error(self):
+        with self.assertRaises(SystemExit) as raised:
+            self.main("--inbox", os.path.join(self.inbox, "absent"), "--db", self.db)
+        self.assertEqual(raised.exception.code, 2)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_db_in_a_missing_directory_is_a_usage_error(self):
+        with self.assertRaises(SystemExit) as raised:
+            self.main("--inbox", self.inbox, "--db", os.path.join(self.inbox, "absent", "r.db"))
+        self.assertEqual(raised.exception.code, 2)
+
+
+class ModuleTest(unittest.TestCase):
+    def test_python_m_readings_exits_with_mains_status(self):
+        base = temp_dir(self)
+        inbox = os.path.join(base, "inbox")
+        os.mkdir(inbox)
+        write(inbox, "ST031_202601150600.csv", "garbage\n")
+        done = subprocess.run(
+            [sys.executable, "-m", "readings", "--inbox", inbox, "--db", os.path.join(base, "r.db")],
+            cwd=REPO, capture_output=True, text=True)
+        self.assertEqual(done.returncode, 1)
+        self.assertEqual(done.stdout,
+                         "files=1 imported=0 skipped=0 failed=1 poisoned=0 stored=0 duplicates=0 rejected=0\n")

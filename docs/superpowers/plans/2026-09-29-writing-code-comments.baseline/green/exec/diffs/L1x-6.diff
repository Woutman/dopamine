+import contextlib
+import io
+import os
+import subprocess
+import sys
+import unittest
+
+from readings import cli
+from readings.runner import Summary
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+NAME = "ST014_202601150600.csv"
+GOOD_TEXT = HEADER + "2026-01-15T00:00,3.1,1012.4,4.2\n"
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        base = temp_dir(self)
+        self.inbox = os.path.join(base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(base, "readings.db")
+
+    def main(self, *extra):
+        """(status, stdout, stderr) of one cli.main run against this test's inbox and db."""
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = cli.main(["--inbox", self.inbox, "--db", self.db, *extra])
+        return status, out.getvalue(), err.getvalue()
+
+    def open_store(self):
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        return store
+
+    def test_summary_line_fields_in_order(self):
+        self.assertEqual(cli.summary_line(Summary(4, 2, 1, 1, 0, 30, 6, 1)),
+                         "files=4 imported=2 skipped=1 failed=1 poisoned=0 stored=30 duplicates=6 rejected=1")
+
+    def test_clean_run(self):
+        write(self.inbox, NAME, GOOD_TEXT)
+        status, out, err = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                              "stored=3 duplicates=0 rejected=0\n")
+        self.assertEqual(err, "")
+        self.assertEqual(self.open_store().count(), 3)
+
+    def test_empty_inbox_is_a_clean_run(self):
+        status, out, _ = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=0 imported=0 skipped=0 failed=0 poisoned=0 "
+                              "stored=0 duplicates=0 rejected=0\n")
+
+    def test_unreadable_file_over_four_runs(self):
+        with open(os.path.join(self.inbox, NAME), "w", encoding="utf-16") as f:
+            f.write(GOOD_TEXT)
+        runs = [self.main() for _ in range(4)]
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertTrue(runs[0][2].startswith(f"{NAME}: failed (1): not text"))
+        self.assertTrue(runs[2][2].startswith(f"{NAME}: poisoned (3): not text"))
+        self.assertEqual(runs[3][2], "")
+        self.assertEqual(runs[3][1], "files=1 imported=0 skipped=0 failed=0 poisoned=1 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        store = self.open_store()
+        self.assertEqual(store.marker(NAME).failures, 3)
+        self.assertEqual(store.count(), 0)
+
+    def test_poisoned_outranks_failed(self):
+        store = Store(self.db)
+        store.set_marker("ST014_202601150000.csv", "poisoned", 3, "not text")
+        store.commit()
+        store.close()
+        write(self.inbox, "ST014_202601150000.csv", GOOD_TEXT)
+        write(self.inbox, NAME, "")
+        status, _, err = self.main()
+        self.assertEqual(status, 3)
+        self.assertEqual(err, f"{NAME}: failed (1): header has no delimiter\n")
+        self.assertEqual(self.open_store().count(), 0)
+
+    def test_partial_copy_then_complete(self):
+        write(self.inbox, NAME, "")
+        self.assertEqual(self.main()[0], 1)
+        write(self.inbox, NAME, GOOD_TEXT)
+        self.assertEqual(self.main()[0], 0)
+        self.assertEqual(self.open_store().count(), 3)
+
+    def test_missing_inbox_is_a_usage_error(self):
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as raised:
+            cli.main(["--inbox", os.path.join(self.inbox, "missing"), "--db", self.db])
+        self.assertEqual(raised.exception.code, 2)
+
+    def test_inbox_that_is_a_file_is_a_usage_error(self):
+        path = write(self.inbox, NAME, GOOD_TEXT)
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as raised:
+            cli.main(["--inbox", path, "--db", self.db])
+        self.assertEqual(raised.exception.code, 2)
+
+
+class ModuleTest(unittest.TestCase):
+    def test_python_m_readings_exits_with_mains_status(self):
+        base = temp_dir(self)
+        inbox = os.path.join(base, "inbox")
+        os.mkdir(inbox)
+        write(inbox, NAME, GOOD_TEXT)
+        done = subprocess.run([sys.executable, "-m", "readings", "--inbox", inbox,
+                               "--db", os.path.join(base, "readings.db")],
+                              cwd=REPO, capture_output=True, text=True)
+        self.assertEqual(done.returncode, 0)
+        self.assertEqual(done.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                      "stored=3 duplicates=0 rejected=0\n")
+        missing = subprocess.run([sys.executable, "-m", "readings", "--inbox",
+                                  os.path.join(base, "missing")],
+                                 cwd=REPO, capture_output=True, text=True)
+        self.assertEqual(missing.returncode, 2)

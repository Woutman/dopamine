+import contextlib
+import io
+import os
+import subprocess
+import sys
+import unittest
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+GOOD = "ST014_202601150600.csv"
+OVERLAPPING = "ST014_202601151200.csv"
+BROKEN = "ST020_202601150600.csv"
+ALSO_BROKEN = "ST021_202601150600.csv"
+ROW_0000 = "2026-01-15T00:00,3.1,1012.4,4.2\n"
+ROW_0100 = "2026-01-15T01:00,3.0,1012.1,4.0\n"
+
+
+def line(**counts):
+    fields = ("files", "imported", "skipped", "failed", "poisoned", "stored", "duplicates", "rejected")
+    return " ".join(f"{name}={counts.get(name, 0)}" for name in fields) + "\n"
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.inbox = temp_dir(self)
+        self.db = os.path.join(temp_dir(self), "readings.db")
+
+    def main(self, argv=None):
+        """(status, stdout, stderr) of one cli.main call."""
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = cli.main(["--inbox", self.inbox, "--db", self.db] if argv is None else argv)
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        try:
+            return store.count()
+        finally:
+            store.close()
+
+    def test_clean_run_exits_0(self):
+        write(self.inbox, GOOD, HEADER + ROW_0000)
+        self.assertEqual(self.main(), (0, line(files=1, imported=1, stored=3), ""))
+        self.assertEqual(self.stored(), 3)
+
+    def test_summary_counts_every_kind_of_file(self):
+        write(self.inbox, GOOD, HEADER + ROW_0000)
+        self.main()
+        write(self.inbox, OVERLAPPING, HEADER + ROW_0000 + "--:--,3.0,1012.1,4.0\n" + ROW_0100)
+        write(self.inbox, BROKEN, "garbage\n")
+        self.assertEqual(self.main(),
+                         (1, line(files=3, imported=1, skipped=1, failed=1, stored=3, duplicates=3, rejected=1),
+                          f"{BROKEN}: failed (1): header has no delimiter\n"))
+        self.assertEqual(self.stored(), 6)
+
+    def test_unreadable_file_exits_1_1_3_3(self):
+        write(self.inbox, BROKEN, "garbage\n")
+        self.assertEqual([self.main()[0] for _ in range(4)], [1, 1, 3, 3])
+        self.assertEqual(self.stored(), 0)
+
+    def test_poisoned_outranks_failed(self):
+        write(self.inbox, BROKEN, "garbage\n")
+        for _ in range(3):
+            self.main()
+        write(self.inbox, ALSO_BROKEN, "garbage\n")
+        self.assertEqual(self.main(),
+                         (3, line(files=2, failed=1, poisoned=1),
+                          f"{ALSO_BROKEN}: failed (1): header has no delimiter\n"))
+
+    def test_empty_inbox_exits_0(self):
+        self.assertEqual(self.main(), (0, line(), ""))
+
+    def test_missing_inbox_is_a_usage_error(self):
+        status, out, err = self.main(["--inbox", os.path.join(self.inbox, "absent"), "--db", self.db])
+        self.assertEqual((status, out), (2, ""))
+        self.assertIn("inbox not found", err)
+        self.assertFalse(os.path.exists(self.db))
+
+
+class ModuleTest(unittest.TestCase):
+    def setUp(self):
+        self.inbox = temp_dir(self)
+
+    def module(self, db):
+        return subprocess.run([sys.executable, "-m", "readings", "--inbox", self.inbox, "--db", db],
+                              cwd=ROOT, capture_output=True, text=True)
+
+    def test_exits_with_mains_status(self):
+        write(self.inbox, GOOD, HEADER + ROW_0000)
+        result = self.module(os.path.join(temp_dir(self), "readings.db"))
+        self.assertEqual((result.returncode, result.stdout), (0, line(files=1, imported=1, stored=3)))
+
+    def test_store_that_cannot_open_stops_the_run_with_1(self):
+        write(self.inbox, GOOD, HEADER + ROW_0000)
+        result = self.module(temp_dir(self))  # a directory: sqlite cannot open it
+        self.assertEqual((result.returncode, result.stdout), (1, ""))
+        self.assertIn("OperationalError", result.stderr)

+import io
+import os
+import subprocess
+import sys
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+EARLY = "ST014_202601150600.csv"
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.base = temp_dir(self)
+        self.inbox = os.path.join(self.base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(self.base, "readings.db")
+
+    def main(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = cli.main(["--inbox", self.inbox, "--db", self.db, *argv])
+        return status, out.getvalue(), err.getvalue()
+
+    def test_clean_run(self):
+        write(self.inbox, EARLY, HEADER + "--:--,1,1,1\n2026-01-15T00:00,3.1,1012.4,4.2\n")
+        status, out, err = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                              "stored=3 duplicates=0 rejected=1\n")
+        self.assertEqual(err, "")
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        self.assertEqual(store.count(), 3)
+
+    def test_second_run_skips_and_stores_nothing(self):
+        write(self.inbox, EARLY, HEADER + "2026-01-15T00:00,3.1,1012.4,4.2\n")
+        self.main()
+        status, out, _ = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=1 imported=0 skipped=1 failed=0 poisoned=0 "
+                              "stored=0 duplicates=0 rejected=0\n")
+        store = Store(self.db)
+        self.addCleanup(store.close)
+        self.assertEqual(store.count(), 3)
+
+    def test_unreadable_file_exit_statuses_over_four_runs(self):
+        with open(os.path.join(self.inbox, EARLY), "wb") as f:
+            f.write("time,temp_c\n".encode("utf-16"))
+        runs = [self.main() for _ in range(4)]
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertEqual(runs[0][1], "files=1 imported=0 skipped=0 failed=1 poisoned=0 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(runs[3][1], "files=1 imported=0 skipped=0 failed=0 poisoned=1 "
+                                     "stored=0 duplicates=0 rejected=0\n")
+        self.assertTrue(runs[2][2].startswith(f"{EARLY}: poisoned (3): not text: "))
+        self.assertEqual(runs[3][2], "")
+
+    def test_poisoned_takes_precedence_over_failed(self):
+        with open(os.path.join(self.inbox, EARLY), "wb") as f:
+            f.write("time,temp_c\n".encode("utf-16"))
+        for _ in range(3):
+            self.main()
+        write(self.inbox, "ST014_202601151200.csv", "")
+        status, _, _ = self.main()
+        self.assertEqual(status, 3)
+
+    def test_empty_inbox(self):
+        status, out, err = self.main()
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "files=0 imported=0 skipped=0 failed=0 poisoned=0 "
+                              "stored=0 duplicates=0 rejected=0\n")
+        self.assertEqual(err, "")
+
+    def test_missing_inbox_is_a_usage_error_and_creates_no_store(self):
+        missing = os.path.join(self.base, "nowhere")
+        err = io.StringIO()
+        with redirect_stderr(err), self.assertRaises(SystemExit) as raised:
+            cli.main(["--inbox", missing, "--db", self.db])
+        self.assertEqual(raised.exception.code, 2)
+        self.assertIn("nowhere", err.getvalue())
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_module_runs_with_defaults(self):
+        # Defaults are relative to the working directory: ./inbox and ./readings.db.
+        write(self.inbox, EARLY, HEADER + "2026-01-15T00:00,3.1,1012.4,4.2\n")
+        done = subprocess.run([sys.executable, "-m", "readings"], cwd=self.base,
+                              env={**os.environ, "PYTHONPATH": ROOT},
+                              capture_output=True, text=True)
+        self.assertEqual(done.returncode, 0, done.stderr)
+        self.assertEqual(done.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                      "stored=3 duplicates=0 rejected=0\n")
+        self.assertTrue(os.path.exists(self.db))

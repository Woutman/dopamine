+    def quiet_run(self, store=None):
+        err = io.StringIO()
+        with redirect_stderr(err):
+            summary = runner.run(self.inbox, store or self.store)
+        return summary, err.getvalue()
+
+    def test_unreadable_file_over_four_runs(self):
+        with open(os.path.join(self.inbox, EARLY), "wb") as f:
+            f.write("time,temp_c\n".encode("utf-16"))
+        results = [self.quiet_run() for _ in range(4)]
+        self.assertEqual([s for s, _ in results],
+                         [Summary(files=1, failed=1), Summary(files=1, failed=1),
+                          Summary(files=1, poisoned=1), Summary(files=1, poisoned=1)])
+        marker = self.store.marker(EARLY)
+        self.assertEqual((marker.state, marker.failures), ("poisoned", 3))
+        self.assertTrue(marker.detail.startswith("not text: "))
+        lines = [err for _, err in results]
+        self.assertTrue(lines[0].startswith(f"{EARLY}: failed (1): not text: "))
+        self.assertTrue(lines[1].startswith(f"{EARLY}: failed (2): not text: "))
+        self.assertTrue(lines[2].startswith(f"{EARLY}: poisoned (3): not text: "))
+        self.assertEqual(lines[3], "")
+        self.assertEqual(self.store.count(), 0)

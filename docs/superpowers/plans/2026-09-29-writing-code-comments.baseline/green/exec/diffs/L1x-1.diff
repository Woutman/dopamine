+++ b/tests/test_cli.py
@@ -0,0 +1,143 @@
+import io
+import os
+import subprocess
+import sys
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from readings import cli
+from readings.runner import Summary
+from readings.store import Store
+from tests.helpers import HEADER, temp_dir, write
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+EARLY = "ST014_202601150000.csv"
+LATER = "ST014_202601150600.csv"
+BROKEN = "ST022_202601150600.csv"
+OTHER = "ST031_202601150600.csv"
+
+EARLY_TEXT = HEADER + "2026-01-15T00:00,3.1,1012.4,4.2\n"
+# One reading row repeats EARLY's, one is a clock reset, one is new.
+LATER_TEXT = HEADER + ("2026-01-15T00:00,3.1,1012.4,4.2\n"
+                       "--:--,3.0,1012.1,4.0\n"
+                       "2026-01-15T06:00,2.5,1011.6,3.5\n")
+
+
+class SummaryLineTest(unittest.TestCase):
+    def test_fields_in_order(self):
+        summary = Summary(files=4, imported=2, skipped=1, failed=1, stored=30, duplicates=6,
+                          rejected=1)
+        self.assertEqual(cli.summary_line(summary),
+                         "files=4 imported=2 skipped=1 failed=1 poisoned=0 stored=30 "
+                         "duplicates=6 rejected=1")
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.base = temp_dir(self)
+        self.inbox = os.path.join(self.base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(self.base, "readings.db")
+
+    def main(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            status = cli.main(list(argv) or ["--inbox", self.inbox, "--db", self.db])
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        try:
+            return store.count()
+        finally:
+            store.close()
+
+    def test_clean_run_exits_0(self):
+        write(self.inbox, EARLY, EARLY_TEXT)
+        self.assertEqual(self.main(), (
+            0, "files=1 imported=1 skipped=0 failed=0 poisoned=0 stored=3 duplicates=0 rejected=0\n",
+            ""))
+        self.assertEqual(self.stored(), 3)
+
+    def test_mixed_run_exits_1_and_names_the_failed_file(self):
+        write(self.inbox, EARLY, EARLY_TEXT)
+        self.main()
+        write(self.inbox, LATER, LATER_TEXT)
+        write(self.inbox, BROKEN, "garbage\n")
+
+        self.assertEqual(self.main(), (
+            1, "files=3 imported=1 skipped=1 failed=1 poisoned=0 stored=3 duplicates=3 rejected=1\n",
+            f"{BROKEN}: failed (1): header has no delimiter\n"))
+        self.assertEqual(self.stored(), 6)
+
+    def test_unreadable_file_over_four_runs(self):
+        write(self.inbox, BROKEN, "garbage\n")
+        failed = "files=1 imported=0 skipped=0 failed=1 poisoned=0 stored=0 duplicates=0 rejected=0\n"
+        poisoned = "files=1 imported=0 skipped=0 failed=0 poisoned=1 stored=0 duplicates=0 rejected=0\n"
+        expected = [
+            (1, failed, f"{BROKEN}: failed (1): header has no delimiter\n"),
+            (1, failed, f"{BROKEN}: failed (2): header has no delimiter\n"),
+            (3, poisoned, f"{BROKEN}: poisoned (3): header has no delimiter\n"),
+            (3, poisoned, f"{BROKEN}: poisoned (3): header has no delimiter\n"),
+        ]
+        for number, result in enumerate(expected, 1):
+            with self.subTest(run=number):
+                self.assertEqual(self.main(), result)
+                self.assertEqual(self.stored(), 0)
+
+    def test_poisoned_outranks_failed(self):
+        write(self.inbox, BROKEN, "garbage\n")
+        for _ in range(3):
+            self.main()
+        write(self.inbox, OTHER, "garbage\n")
+
+        self.assertEqual(self.main(), (
+            3, "files=2 imported=0 skipped=0 failed=1 poisoned=1 stored=0 duplicates=0 rejected=0\n",
+            f"{BROKEN}: poisoned (3): header has no delimiter\n"
+            f"{OTHER}: failed (1): header has no delimiter\n"))
+        self.assertEqual(self.stored(), 0)
+
+    def test_missing_inbox_is_a_usage_error(self):
+        status, out, err = self.main("--inbox", os.path.join(self.base, "nowhere"),
+                                     "--db", self.db)
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertIn("no inbox directory at", err)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_store_directory_missing_is_a_usage_error(self):
+        db = os.path.join(self.base, "nowhere", "readings.db")
+        status, out, err = self.main("--inbox", self.inbox, "--db", db)
+        self.assertEqual(status, 2)
+        self.assertEqual(out, "")
+        self.assertIn("no directory for the store at", err)
+        self.assertFalse(os.path.exists(os.path.dirname(db)))
+
+
+class ModuleTest(unittest.TestCase):
+    def setUp(self):
+        self.base = temp_dir(self)
+        os.mkdir(os.path.join(self.base, "inbox"))
+        write(os.path.join(self.base, "inbox"), EARLY, EARLY_TEXT)
+
+    def python_m(self, *argv):
+        env = dict(os.environ, PYTHONPATH=ROOT)
+        return subprocess.run([sys.executable, "-m", "readings", *argv], cwd=self.base,
+                              env=env, capture_output=True, text=True)
+
+    def test_defaults_are_inbox_and_readings_db(self):
+        result = self.python_m()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                        "stored=3 duplicates=0 rejected=0\n")
+        store = Store(os.path.join(self.base, "readings.db"))
+        self.addCleanup(store.close)
+        self.assertEqual(store.count(), 3)
+
+    def test_a_store_that_cannot_be_opened_stops_the_run(self):
+        # A directory where the store file should be: sqlite3 cannot open it.
+        result = self.python_m("--db", self.base)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("sqlite3.OperationalError", result.stderr)

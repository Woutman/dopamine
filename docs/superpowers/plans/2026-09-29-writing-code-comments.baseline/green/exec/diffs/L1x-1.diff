+class FailureTest(InboxCase):
+    def run_once(self):
+        problems = []
+        summary = runner.run(self.inbox, self.store,
+                             on_problem=lambda name, marker: problems.append((name, marker)))
+        return summary, problems
+
+    def poison(self, name):
+        write(self.inbox, name, "garbage\n")
+        for _ in range(runner.POISON_AFTER):
+            self.run_once()
+
+    def test_unreadable_file_is_poisoned_on_its_third_failure(self):
+        write(self.inbox, BROKEN, "garbage\n")
+        expected = [
+            (Summary(files=1, failed=1), Marker("failed", 1, "header has no delimiter")),
+            (Summary(files=1, failed=1), Marker("failed", 2, "header has no delimiter")),
+            (Summary(files=1, poisoned=1), Marker("poisoned", 3, "header has no delimiter")),
+            (Summary(files=1, poisoned=1), Marker("poisoned", 3, "header has no delimiter")),
+        ]
+        for number, (summary, marker) in enumerate(expected, 1):
+            with self.subTest(run=number):
+                if number == 4:
+                    # Parseable now: the fourth run passes only if it never opens the file.
+                    write(self.inbox, BROKEN, MORNING_TEXT)
+                got, problems = self.run_once()
+                self.assertEqual(got, summary)
+                self.assertEqual(self.store.marker(BROKEN), marker)
+                self.assertEqual(problems, [(BROKEN, marker)])
+                self.assertEqual(self.store.count(), 0)
+
+    def test_a_poisoned_file_does_not_stop_the_others(self):
+        self.poison(BROKEN)
+        write(self.inbox, MORNING, MORNING_TEXT)
+
+        summary, problems = self.run_once()
+
+        self.assertEqual(summary, Summary(files=2, imported=1, poisoned=1, stored=9))
+        self.assertEqual(self.store.count(), 9)
+        self.assertEqual([name for name, _ in problems], [BROKEN])
+
+    def test_unknown_column_fails_the_file(self):
+        write(self.inbox, MORNING, "time,temp_c,humidity\n2026-01-15T00:00,3.1,80\n")
+
+        summary, _ = self.run_once()

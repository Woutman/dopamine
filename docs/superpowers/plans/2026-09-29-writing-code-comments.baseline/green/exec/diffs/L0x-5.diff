+import contextlib
+import io
+import os
+import sqlite3
+import subprocess
+import sys
+import unittest
+
+from readings import cli
+from readings.store import Store
+from tests.helpers import HEADER, row, temp_dir, write, write_utf16
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+A = "ST014_202601150600.csv"
+B = "ST014_202601151200.csv"
+C = "ST022_202601150600.csv"
+D = "ST031_202601150600.csv"
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.base = temp_dir(self)
+        self.inbox = os.path.join(self.base, "inbox")
+        os.mkdir(self.inbox)
+        self.db = os.path.join(self.base, "readings.db")
+
+    def main(self, *argv):
+        """(status, stdout, stderr) of cli.main over this test's inbox and store."""
+        argv = argv or ("--inbox", self.inbox, "--db", self.db)
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = cli.main(list(argv))
+        return status, out.getvalue(), err.getvalue()
+
+    def stored(self):
+        store = Store(self.db)
+        try:
+            return store.count()
+        finally:
+            store.close()
+
+    def test_clean_run_exits_0(self):
+        write(self.inbox, A, HEADER + row(0))
+        self.assertEqual(self.main(), (0, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                          "stored=3 duplicates=0 rejected=0\n", ""))
+        self.assertEqual(self.stored(), 3)
+
+    def test_summary_line_and_a_failed_file(self):
+        write(self.inbox, A, HEADER + row(0) + row(1) + row(2))
+        self.main()
+        write(self.inbox, B, HEADER + row(2) + row(3) + row(4))
+        write(self.inbox, C, HEADER + "--:--,3.1,1012.4,4.2\n" + row(0) + row(1))
+        write_utf16(self.inbox, D)
+
+        status, out, err = self.main()
+
+        self.assertEqual(status, 1)
+        self.assertEqual(out, "files=4 imported=2 skipped=1 failed=1 poisoned=0 "
+                              "stored=12 duplicates=3 rejected=1\n")
+        lines = err.splitlines()
+        self.assertEqual(len(lines), 1)
+        self.assertTrue(lines[0].startswith(f"{D}: failed (1): not text: "), lines[0])
+        self.assertEqual(self.stored(), 21)
+
+    def test_unreadable_file_over_four_runs(self):
+        write(self.inbox, A, HEADER + row(0))
+        write_utf16(self.inbox, D)
+
+        runs = [self.main() for _ in range(3)]
+        write(self.inbox, B, HEADER + row(5))  # a new export arrives before the fourth run
+        runs.append(self.main())
+
+        self.assertEqual([status for status, _, _ in runs], [1, 1, 3, 3])
+        self.assertTrue(runs[0][2].startswith(f"{D}: failed (1): not text: "))
+        self.assertTrue(runs[1][2].startswith(f"{D}: failed (2): not text: "))
+        self.assertTrue(runs[2][2].startswith(f"{D}: poisoned (3): not text: "))
+        self.assertEqual(runs[3][2], "")  # poisoned before this run: counted, not reported
+        # a poisoned file does not stop the rest of the inbox from importing
+        self.assertEqual(runs[3][1], "files=3 imported=1 skipped=1 failed=0 poisoned=1 "
+                                     "stored=3 duplicates=0 rejected=0\n")
+        self.assertEqual(self.stored(), 6)
+
+    def test_missing_inbox_is_a_usage_error(self):
+        missing = os.path.join(self.base, "nowhere")
+        with self.assertRaises(SystemExit) as caught:
+            self.main("--inbox", missing, "--db", self.db)
+        self.assertEqual(caught.exception.code, 2)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_inbox_that_is_a_file_is_a_usage_error(self):
+        path = write(self.base, "inbox.txt", "not a directory\n")
+        with self.assertRaises(SystemExit) as caught:
+            self.main("--inbox", path, "--db", self.db)
+        self.assertEqual(caught.exception.code, 2)
+        self.assertFalse(os.path.exists(self.db))
+
+    def test_store_error_propagates(self):
+        write(self.inbox, A, HEADER + row(0))
+        with self.assertRaises(sqlite3.OperationalError):
+            self.main("--inbox", self.inbox, "--db", self.inbox)  # a directory is no database
+
+
+class ModuleTest(unittest.TestCase):
+    """python3 -m readings, as Phase 3's timer will run it."""
+
+    def setUp(self):
+        self.base = temp_dir(self)
+        os.mkdir(os.path.join(self.base, "inbox"))
+        write(os.path.join(self.base, "inbox"), A, HEADER + row(0))
+
+    def module(self, *argv):
+        env = dict(os.environ, PYTHONPATH=REPO)
+        return subprocess.run([sys.executable, "-m", "readings", *argv], cwd=self.base, env=env,
+                              capture_output=True, text=True)
+
+    def test_defaults_are_inbox_and_readings_db(self):
+        result = self.module()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "files=1 imported=1 skipped=0 failed=0 poisoned=0 "
+                                        "stored=3 duplicates=0 rejected=0\n")
+        self.assertTrue(os.path.exists(os.path.join(self.base, "readings.db")))
+
+    def test_a_run_that_stops_exits_1(self):
+        result = self.module("--db", "inbox")  # a directory is no database
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("OperationalError", result.stderr)
+
+    def test_usage_error_exits_2(self):
+        result = self.module("--inbox", "nowhere")
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stdout, "")

+"""Command-line entrypoint: runs one export over a JSON file of records and prints its report.
+
+    python3 -m exporter.report RECORDS_JSON [CURSOR]
+"""
+
+import argparse
+import json
+
+from exporter import job
+from exporter.source import Source
+from exporter.store import Store
+
+
+class RecordsError(Exception):
+    """The records file cannot be read, or does not hold a list of records."""
+
+
+def main(argv=None):
+    """Run one export and print its report line. Returns 0; exits 2 on a usage error."""
+    parser = argparse.ArgumentParser(
+        prog="python3 -m exporter.report", description="Run one export and print its report."
+    )
+    parser.add_argument("records_json", metavar="RECORDS_JSON", help="a JSON file holding a list of records")
+    parser.add_argument("cursor", metavar="CURSOR", nargs="?", default="", help="start after this record id")
+    args = parser.parse_args(argv)
+    try:
+        records = load_records(args.records_json)
+    except RecordsError as error:
+        parser.error(str(error))
+    print(format_report(job.run(Source(records), Store(), args.cursor)))
+    return 0
+
+
+def load_records(path):
+    """The records in the JSON file at `path`: a list of objects, each with a string id and a status."""
+    try:
+        with open(path, encoding="utf-8") as file:
+            records = json.load(file)
+    except OSError as error:
+        raise RecordsError(f"cannot read {path}: {error.strerror}") from error
+    except ValueError as error:
+        raise RecordsError(f"{path} is not valid JSON: {error}") from error
+    if not isinstance(records, list):
+        raise RecordsError(f"{path} must hold a JSON list of records")
+    for index, record in enumerate(records):
+        if not (isinstance(record, dict) and isinstance(record.get("id"), str) and "status" in record):
+            raise RecordsError(f'record {index} in {path} is not an object with a string "id" and a "status"')
+    return records
+
+
+def format_report(result):
+    """The one-line report of spec §4."""
+    return (
+        f"exported={result.exported} skipped={result.skipped} requests={result.requests} "
+        f"stopped_by_budget={'yes' if result.stopped_by_budget else 'no'} cursor={result.cursor}"
+    )
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+```
+
+`except ValueError` catches both `json.JSONDecodeError` and `UnicodeDecodeError`, since each is a `ValueError`. `parser.error` prints the usage and the message to stderr and exits 2.

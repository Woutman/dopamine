diff --git a/tests/test_job.py b/tests/test_job.py
index c6147a3..e816f98 100644
--- a/tests/test_job.py
+++ b/tests/test_job.py
@@ -36,6 +36,32 @@ class RunTest(unittest.TestCase):
         self.assertTrue(result.stopped_by_budget)
         self.assertEqual((sorted(store.records), result.cursor), (["a", "b"], "b"))
 
+    def test_splits_a_large_page_into_batches_of_at_most_25(self):
+        store = Store()
+        result = job.run(Source([record(f"{n:03d}") for n in range(60)]), store)
+        self.assertEqual((result.exported, store.requests), (60, 3))
+
+    def test_never_exceeds_the_budget_and_resumes_mid_page(self):
+        """A run stopped between batches of one page keeps its cursor at the last batch written."""
+        records = [record(f"{n:03d}") for n in range(60)]
+        store = Store()
+        with mock.patch.object(job, "MAX_REQUESTS", 2):
+            first = job.run(Source(records), store)
+        self.assertTrue(first.stopped_by_budget)
+        self.assertEqual((store.requests, first.exported, first.cursor), (2, 50, "049"))
+        second = job.run(Source(records), store, first.cursor)
+        self.assertEqual((len(store.records), first.exported + second.exported), (60, 60))
+        self.assertFalse(second.stopped_by_budget)
+
+    def test_drafts_after_an_unwritten_batch_are_not_counted_or_passed(self):
+        records = [record(f"{n:03d}") for n in range(25)] + [record("025", "draft"), record("026")]
+        store = Store()
+        with mock.patch.object(job, "MAX_REQUESTS", 1):
+            first = job.run(Source(records), store)
+        self.assertEqual((first.exported, first.skipped, first.cursor), (25, 0, "024"))
+        second = job.run(Source(records), store, first.cursor)
+        self.assertEqual((second.exported, second.skipped), (1, 1))
+
 
 if __name__ == "__main__":
     unittest.main()

         self.assertTrue(result.stopped_by_budget)
         self.assertEqual((sorted(store.records), result.cursor), (["a", "b"], "b"))
 
+    def test_splits_a_full_source_page_into_batches_of_at_most_25(self):
+        store = Store()
+        records = [record(f"{n:03d}") for n in range(100)]
+        result = job.run(Source(records), store)
+        self.assertEqual((result.exported, store.requests, len(store.records)), (100, 4, 100))
+
+    def test_checks_the_budget_before_every_batch_within_a_page(self):
+        """A page of 60 needs three requests; with a budget of 2 the run stops after 50 and resumes at the 51st."""
+        records = [record(f"{n:03d}") for n in range(60)]
+        store = Store()
+        with mock.patch.object(job, "MAX_REQUESTS", 2):
+            first = job.run(Source(records), store)
+        self.assertTrue(first.stopped_by_budget)
+        self.assertEqual((store.requests, len(store.records), first.cursor), (2, 50, "049"))
+        second = job.run(Source(records), store, first.cursor)
+        self.assertEqual((second.exported, len(store.records)), (10, 60))
+
+    def test_counts_drafts_among_batched_records_once(self):
+        records = [record(f"{n:03d}", "draft" if n % 2 else "live") for n in range(60)]
+        store = Store()
+        result = job.run(Source(records), store)
+        self.assertEqual((result.exported, result.skipped, result.cursor), (30, 30, "059"))
+
 
 if __name__ == "__main__":
     unittest.main()

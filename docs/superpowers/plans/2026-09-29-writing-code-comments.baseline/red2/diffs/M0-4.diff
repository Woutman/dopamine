+
+USAGE = "usage: python3 -m exporter.report RECORDS_JSON [CURSOR]"
+
+
+def format_report(result, requests):
+    return (
+        f"exported={result.exported} skipped={result.skipped} requests={requests} "
+        f"stopped_by_budget={'yes' if result.stopped_by_budget else 'no'} cursor={result.cursor}"
+    )
 
 
 def main(argv=None):
-    raise NotImplementedError("the run report is not implemented yet")
+    """Run one export over the records in RECORDS_JSON and print the report line.
+
+    Returns 0 whether the run completed or stopped at the budget, and 2 on a usage error, which
+    includes a records file that cannot be read as a JSON list.
+    """
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) not in (1, 2):
+        print(USAGE, file=sys.stderr)
+        return 2
+    path = args[0]
+    cursor = args[1] if len(args) == 2 else ""
+    try:
+        with open(path) as f:
+            records = json.load(f)
+    except (OSError, json.JSONDecodeError) as error:
+        print(f"{USAGE}\ncannot read {path}: {error}", file=sys.stderr)
+        return 2
+    if not isinstance(records, list):
+        print(f"{USAGE}\n{path} must hold a JSON list of records", file=sys.stderr)
+        return 2
+    store = Store()
+    result = job.run(Source(records), store, cursor)
+    print(format_report(result, store.requests))
+    return 0
 
 

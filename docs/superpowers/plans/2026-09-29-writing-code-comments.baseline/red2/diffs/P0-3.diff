+- [ ] **Step 3: Implement batch writes**
+
+Replace `exporter/job.py` with:
+
+```python
+"""The export job: copies records from the source to the store within a request budget."""
+
+from dataclasses import dataclass
+
+from exporter.store import MAX_BATCH
+
+SOURCE_PAGE_SIZE = 100
+MAX_REQUESTS = 500
+
+
+@dataclass
+class RunResult:
+    exported: int = 0
+    skipped: int = 0
+    requests: int = 0
+    cursor: str = ""
+    stopped_by_budget: bool = False
+
+
+def run(source, store, cursor=""):
+    """Export every record after `cursor` with put_many, making at most MAX_REQUESTS store requests.
+
+    The result's cursor is the id of the last record written or skipped, so the next run resumes
+    after it: records read into a batch the budget stopped from being written are not passed.
+    """
+    result = RunResult(cursor=cursor)
+    # Records read but not yet dealt with; the first, if any, is live.
+    pending = []
+    # The source is paged from the last record read: the cursor lags behind `pending`.
+    after = cursor
+    while True:
+        page = source.page(after, SOURCE_PAGE_SIZE)
+        if not page:
+            break
+        after = page[-1]["id"]
+        for record in page:
+            if _is_draft(record) and not pending:
+                result.skipped += 1
+                result.cursor = record["id"]
+                continue
+            pending.append(record)
+            if not _is_draft(record) and _live_count(pending) == MAX_BATCH:
+                if not _flush(store, pending, result):
+                    return result
+                pending = []
+    if pending:
+        _flush(store, pending, result)
+    return result
+
+
+def _is_draft(record):
+    return record["status"] == "draft"
+
+
+def _live_count(records):
+    return sum(1 for record in records if not _is_draft(record))
+
+
+def _flush(store, pending, result):
+    """Write the live records in `pending` in one request, and count all of `pending` as dealt with.
+
+    Returns False, having written nothing, when the request would exceed the budget.
+    """
+    if result.requests >= MAX_REQUESTS:
+        result.stopped_by_budget = True
+        return False
+    live = [(record["id"], record) for record in pending if not _is_draft(record)]
+    store.put_many(live)
+    result.requests += 1
+    result.exported += len(live)
+    result.skipped += len(pending) - len(live)
+    result.cursor = pending[-1]["id"]
+    return True
+```
+
+This also removes the old comment `# One put per record: the store has no batch write.`, which is no longer true.

+```python
+"""Command-line entrypoint: runs one export over a JSON file of records and prints its report."""
+
+import json
+import sys
+
+from exporter import job
+from exporter.source import Source
+from exporter.store import Store
+
+USAGE = "usage: python3 -m exporter.report RECORDS_JSON [CURSOR]"
+
+
+def main(argv=None):
+    """Run one export and print its report line; return the exit code (0, or 2 on a usage error)."""
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) not in (1, 2):
+        print(USAGE, file=sys.stderr)
+        return 2
+    try:
+        records = load_records(args[0])
+    except ValueError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+    cursor = args[1] if len(args) == 2 else ""
+    print(format_report(job.run(Source(records), Store(), cursor)))
+    return 0
+
+
+def load_records(path):
+    """The records in the JSON file at `path`. Raises ValueError saying what is wrong with the file."""
+    try:
+        with open(path, encoding="utf-8") as f:
+            records = json.load(f)
+    except OSError as error:
+        raise ValueError(f"cannot read {path}: {error.strerror}") from error
+    except (json.JSONDecodeError, UnicodeDecodeError) as error:
+        raise ValueError(f"{path} is not valid JSON: {error}") from error
+    if not isinstance(records, list) or not all(_is_record(record) for record in records):
+        raise ValueError(
+            f"{path} must hold a JSON list of objects, each with a string id and a status"
+        )
+    return records
+
+
+def _is_record(value):
+    return isinstance(value, dict) and isinstance(value.get("id"), str) and "status" in value
+
+
+def format_report(result):
+    """The report line for a RunResult, without a trailing newline."""
+    return (
+        f"exported={result.exported} skipped={result.skipped} requests={result.requests} "
+        f"stopped_by_budget={'yes' if result.stopped_by_budget else 'no'} cursor={result.cursor}"
+    )
+
+
+if __name__ == "__main__":
+    sys.exit(main())
+```

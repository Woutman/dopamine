diff --git a/tests/test_job.py b/tests/test_job.py
index c6147a3..94e3f92 100644
--- a/tests/test_job.py
+++ b/tests/test_job.py
@@ -36,6 +36,23 @@ class RunTest(unittest.TestCase):
         self.assertTrue(result.stopped_by_budget)
         self.assertEqual((sorted(store.records), result.cursor), (["a", "b"], "b"))
 
+    def test_splits_a_large_page_into_store_sized_batches(self):
+        store = Store()
+        records = [record(f"r{i:03d}") for i in range(60)]
+        result = job.run(Source(records), store)
+        self.assertEqual((result.exported, store.requests), (60, 3))
+
+    def test_never_exceeds_the_budget_within_a_page(self):
+        """A run stopped mid-page keeps the cursor at the last batch written, and a second run finishes."""
+        records = [record(f"r{i:03d}") for i in range(60)]
+        store = Store()
+        with mock.patch.object(job, "MAX_REQUESTS", 2):
+            first = job.run(Source(records), store)
+            self.assertEqual((store.requests, first.stopped_by_budget, first.cursor), (2, True, "r049"))
+        second = job.run(Source(records), store, first.cursor)
+        self.assertEqual((first.exported + second.exported, len(store.records)), (60, 60))
+        self.assertFalse(second.stopped_by_budget)
+
 
 if __name__ == "__main__":
     unittest.main()

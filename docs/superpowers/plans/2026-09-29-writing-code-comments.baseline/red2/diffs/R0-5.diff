@@ -36,6 +36,21 @@ class RunTest(unittest.TestCase):
         self.assertTrue(result.stopped_by_budget)
         self.assertEqual((sorted(store.records), result.cursor), (["a", "b"], "b"))
 
+    def test_splits_a_large_page_into_batches_the_store_accepts(self):
+        store = Store()
+        result = job.run(Source([record(f"r{i:03d}") for i in range(60)]), store)
+        self.assertEqual((result.exported, len(store.records), store.requests), (60, 60, 3))
+
+    def test_never_exceeds_the_budget_mid_page_and_resumes_without_loss(self):
+        records = [record(f"r{i:03d}") for i in range(60)]
+        store = Store()
+        with mock.patch.object(job, "MAX_REQUESTS", 2):
+            first = job.run(Source(records), store)
+        self.assertTrue(first.stopped_by_budget)
+        self.assertEqual((store.requests, len(store.records), first.cursor), (2, 50, "r049"))
+        second = job.run(Source(records), store, cursor=first.cursor)
+        self.assertEqual((len(store.records), first.exported + second.exported), (60, 60))
+
 
 if __name__ == "__main__":
     unittest.main()

#!/usr/bin/env bash
# The PostToolUse admission-test hook. See py-hook for the interpreter probe and
# the reason every dopamine hook fails open.
#
# SCRIPT_DIR is resolved with shell builtins only, never the external `dirname`
# command: this exec is unconditional, so a PATH stripped bare must not take
# dirname down with it (see seal-gate for the regression this avoids). The
# explicit "$sd" = "$0" fallback restores dirname's POSIX-defined "." result
# for a bare name with no "/" — "${0%/*}" alone would leave $0 unchanged there
# and turn a same-directory invocation into a failed cd into a subdirectory.
set -u
sd="${0%/*}"; [ "$sd" = "$0" ] && sd="."
exec "${BASH:-bash}" "$(cd "$sd" && pwd)/py-hook" claude_md_guard.py

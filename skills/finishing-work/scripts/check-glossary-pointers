#!/usr/bin/env bash
# Check that every glossary entry still points at code that exists.
#
# A dead pointer is the one glossary error a grep can find; whether a meaning
# still holds is the sweep's judgement, made along the ledger's terms.
#
# Usage: check-glossary-pointers GLOSSARY ROOT
#   GLOSSARY  the glossary file; each line starting "- **" is one entry, and
#             its last  → `path:symbol`  is its pointer
#   ROOT      the repository root that pointer paths are relative to
#
# Prints one line per failure:
#   dead: <headword>: <path:symbol> (no file)
#   dead: <headword>: <path:symbol> (no symbol)
#   no pointer: <headword>
#
# Exits: 0 every pointer resolves
#        1 any failure
#        2 usage, or a glossary that does not exist
set -euo pipefail

[ $# -eq 2 ] || { echo "usage: check-glossary-pointers GLOSSARY ROOT" >&2; exit 2; }
glossary="$1" root="$2"
[ -f "$glossary" ] || { echo "no glossary at $glossary" >&2; exit 2; }

failed=0
while IFS= read -r line; do
    line="${line%$'\r'}"
    case "$line" in "- **"*) ;; *) continue ;; esac
    rest="${line#- \*\*}"
    headword="${rest%%\*\**}"
    pointer=$(printf '%s\n' "$line" | sed -n 's/.*→ `\([^`]*\)`[[:space:]]*$/\1/p')
    if [ -z "$pointer" ]; then
        echo "no pointer: $headword"
        failed=1
        continue
    fi
    path="${pointer%:*}" symbol="${pointer##*:}"
    if [ ! -f "$root/$path" ]; then
        echo "dead: $headword: $pointer (no file)"
        failed=1
    elif ! grep -qF -- "$symbol" "$root/$path"; then
        echo "dead: $headword: $pointer (no symbol)"
        failed=1
    fi
done < "$glossary"
exit "$failed"

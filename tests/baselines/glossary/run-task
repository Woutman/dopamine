#!/usr/bin/env bash
# Run one task under one arm in a fresh repository, headless, and keep Claude
# Code's JSON result beside the run as RUNS_DIR/LABEL.json for score.
#
# Every run gets an empty Claude config directory holding only the login, so
# user CLAUDE.md, auto-memory and installed plugins stay out: they would add
# the same cost to each arm and shrink the margin between them. --bare would
# do the same but accepts only ANTHROPIC_API_KEY, not a subscription login.
#
# Usage: run-task RUNS_DIR ARM TASK REP   (model from BASELINE_MODEL, default sonnet)
set -euo pipefail

USAGE="usage: run-task RUNS_DIR ARM TASK REP"
HERE="$(cd "$(dirname "$0")" && pwd)"
[ $# -eq 4 ] || { echo "$USAGE" >&2; exit 2; }
runs="$1" arm="$2" task="$3" rep="$4"
kind=$(awk -F'\t' -v t="$task" '$1 == t { print $2 }' "$HERE/tasks/kinds.tsv")
[ -n "$kind" ] || { echo "unknown task: $task" >&2; exit 2; }

config="$runs/.claude-config"
if [ ! -e "$config" ]; then
    mkdir -p "$config"
    login="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
    [ ! -e "$login" ] || ln -s "$login" "$config/.credentials.json"
fi

label="$arm-$task-$rep"
run=$(bash "$HERE/setup-run" "$runs" "$label" "$arm")
context=$(bash "$HERE/inject" "$arm" "$run/docs/GLOSSARY.md")

if [ "$kind" = question ]; then
    schema='{"type":"object","properties":{"answer":{"type":"string"}},"required":["answer"],"additionalProperties":false}'
else
    schema='{"type":"object","properties":{"done":{"type":"boolean"}},"required":["done"],"additionalProperties":false}'
fi

args=(-p "$(cat "$HERE/tasks/$task.md")"
      --model "${BASELINE_MODEL:-sonnet}"
      --output-format json --json-schema "$schema"
      --no-session-persistence --strict-mcp-config
      --settings '{"disableAllHooks": true}'
      --permission-mode acceptEdits
      --allowedTools Read Grep Glob Edit Write "Bash(grep:*)" "Bash(python3:*)")
[ -z "$context" ] || args+=(--append-system-prompt "$context")

(cd "$run" && CLAUDE_CONFIG_DIR="$config" claude "${args[@]}") > "$runs/$label.json"
echo "$runs/$label.json"

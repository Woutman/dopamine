#!/usr/bin/env bash
# Print what session start would inject under ARM, built from the glossary the
# run actually holds so the arms cannot drift from it. Arm A injects nothing.
#
# Usage: inject ARM GLOSSARY_FILE
set -euo pipefail

[ $# -eq 2 ] || { echo "usage: inject ARM GLOSSARY_FILE" >&2; exit 2; }
lookup="Look a term up with \`grep -i '^- \\*\\*<term>' docs/GLOSSARY.md\`, which prints its one line; do not read the whole file."
case "$1" in
    A) ;;
    B) printf 'This project defines its own terms in docs/GLOSSARY.md, one per line. %s\n' "$lookup" ;;
    C) printf "This project's own terms, from docs/GLOSSARY.md:\n\n%s\n" "$(grep '^- \*\*' "$2")" ;;
    D) printf 'This project defines these terms in docs/GLOSSARY.md: %s. %s\n' \
           "$(sed -n 's/^- \*\*\([^*]*\)\*\*.*/\1/p' "$2" | paste -sd, - | sed 's/,/, /g')" "$lookup" ;;
    *) echo "usage: inject ARM GLOSSARY_FILE" >&2; exit 2 ;;
esac

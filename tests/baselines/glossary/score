#!/usr/bin/env python3
"""Score the runs in RUNS_DIR: correctness beside cost, per arm and per task.

Cost is the headline, not raw tokens: Claude Code caches nearly everything,
tool results included, so equal token counts are not equal costs. The token
columns are kept apart for the same reason.

Usage: score RUNS_DIR
"""
import json
import statistics
import sys
from collections import defaultdict
from pathlib import Path

HERE = Path(__file__).resolve().parent


def normalise(answer):
    return answer.strip().strip("\"'`.").casefold()


def row(name, rs):
    mean = lambda k: statistics.mean(r[k] for r in rs)
    spread = statistics.stdev(r["cost"] for r in rs) if len(rs) > 1 else 0.0
    return (f"| {name} | {len(rs)} | {sum(r['ok'] for r in rs)}/{len(rs)} "
            f"| {mean('cost'):.4f} ± {spread:.4f} | {mean('write'):.0f} | {mean('read'):.0f} "
            f"| {mean('out'):.0f} | {mean('turns'):.1f} |")


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: score RUNS_DIR")
    lines = (HERE / "tasks" / "questions.tsv").read_text().splitlines()[1:]
    answers = {line.split("\t")[0]: line.split("\t")[1] for line in lines}
    by_arm, by_task = defaultdict(list), defaultdict(list)
    for path in sorted(Path(sys.argv[1]).glob("*.json")):
        arm, rest = path.stem.split("-", 1)
        task = rest.rsplit("-", 1)[0]
        result = json.loads(path.read_text())
        usage = result.get("usage", {})
        given = (result.get("structured_output") or {}).get("answer", "")
        r = {
            "ok": normalise(given) == normalise(answers[task]),
            "cost": result.get("total_cost_usd", 0.0),
            "write": usage.get("cache_creation_input_tokens", 0),
            "read": usage.get("cache_read_input_tokens", 0),
            "out": usage.get("output_tokens", 0),
            "turns": result.get("num_turns", 0),
        }
        by_arm[arm].append(r)
        by_task[task, arm].append(r)
    header = "| {} | Runs | Correct | Mean $ ± sd | Cache write | Cache read | Out | Turns |"
    rule = "|---|---|---|---|---|---|---|---|"
    print(header.format("Arm"), rule, sep="\n")
    for arm in sorted(by_arm):
        print(row(arm, by_arm[arm]))
    print()
    print(header.format("Task / arm"), rule, sep="\n")
    for task, arm in sorted(by_task):
        print(row(f"{task} {arm}", by_task[task, arm]))


if __name__ == "__main__":
    main()

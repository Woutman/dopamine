#!/usr/bin/env bash
# Set up one baseline run: a fresh repository holding the fixture. Both arms get
# the same repository; arm O differs only in its prompt.
#
# Usage: setup-run RUNS_DIR LABEL   (prints the run's directory)
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
[ $# -eq 2 ] || { echo "usage: setup-run RUNS_DIR LABEL" >&2; exit 2; }
run="$1/$2"
[ ! -e "$run" ] || { echo "$run already exists" >&2; exit 1; }

mkdir -p "$run"
cp -R "$HERE/fixture/." "$run/"
find "$run" -name __pycache__ -prune -exec rm -rf {} +
git -C "$run" init -q
git -C "$run" add -A
git -C "$run" -c user.name=baseline -c user.email=baseline@localhost commit -qm fixture
cd "$run" && pwd

#!/usr/bin/env bash
# Print a task's prompt under ARM. Arm A gets the question alone. Arm O also
# gets the definitions the question needs, so its cost is the floor no glossary
# mechanism can beat: no lookup, and nothing injected beyond what is used.
#
# Usage: prompt ARM TASK
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
USAGE="usage: prompt ARM TASK"
[ $# -eq 2 ] || { echo "$USAGE" >&2; exit 2; }
needs=$(awk -F'\t' -v t="$2" '$1 == t { print $3 }' "$HERE/tasks/questions.tsv")
[ -n "$needs" ] || { echo "unknown task: $2" >&2; exit 2; }
cat "$HERE/tasks/$2.md"
case "$1" in
    A) ;;
    O)
        printf '\nDefinitions you may need:\n'
        IFS=, read -ra terms <<< "$needs"
        for term in "${terms[@]}"; do
            grep -F -- "- **$term**" "$HERE/tasks/definitions.md"
        done
        ;;
    *) echo "$USAGE" >&2; exit 2 ;;
esac
